#!/usr/bin/python3
"""A small first-login guide to the Conake desktop."""
from pathlib import Path
import subprocess
import tkinter as tk
from tkinter import messagebox


def main():
    profile_path = Path("/run/conake/memory-profile")
    profile = profile_path.read_text().strip() if profile_path.exists() else "detecting"
    root = tk.Tk()
    root.title("Welcome to Conake OS")
    root.geometry("590x420")
    root.minsize(540, 400)
    root.configure(background="#11101c")
    content = tk.Frame(root, background="#11101c", padx=34, pady=30)
    content.pack(fill="both", expand=True)

    def label(text, size=11, color="#b5adc9", bold=False):
        widget = tk.Label(content, text=text, font=("Sans", size, "bold" if bold else "normal"),
                          foreground=color, background="#11101c", wraplength=490, justify="left")
        widget.pack(anchor="w", pady=(0, 15))

    def launch(command):
        try:
            subprocess.Popen(command, start_new_session=True)
        except OSError:
            messagebox.showerror("Unable to open", "This application is not available in this session.", parent=root)

    label("C O N A K E   O S", 11, "#8edbdc", True)
    label("Your space. Your story.", 26, "#f1eef9", True)
    label("Bring your own wallpaper, pick an anime-inspired palette, and make the taskbar feel like home.")
    label(f"Memory profile: {profile}. Open Conake Studio to personalize your desktop or start a focus session.", 10)
    buttons = tk.Frame(content, background="#11101c")
    buttons.pack(anchor="w", pady=(8, 12))
    for text, command, color in (
        ("Personalize desktop", lambda: launch(["conake-settings"]), "#f2a7cf"),
        ("Explore apps", lambda: launch(["xfce4-appfinder"]), "#8edbdc"),
    ):
        tk.Button(buttons, text=text, command=command, font=("Sans", 10, "bold"),
                  foreground="#11101c", background=color, activebackground="#efd5f2",
                  relief="flat", padx=16, pady=10).pack(side="left", padx=(0, 12))
    tk.Button(content, text="I'll explore on my own", command=root.destroy,
              foreground="#b5adc9", background="#11101c", activebackground="#29263b",
              activeforeground="#f1eef9", relief="flat", pady=8).pack(anchor="w")
    root.mainloop()


if __name__ == "__main__":
    main()
